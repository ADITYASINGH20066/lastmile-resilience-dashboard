<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071217">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LASTMILE / ALERT RELAY"
            android:textColor="#72D9C6"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="The warning travels."
            android:textColor="#E8F0EC"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Relay is stopped"
            android:textColor="#9BAEAA"
            android:textSize="15sp" />

        <Button
            android:id="@+id/relayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Start nearby relay"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Send demo P0 flood alert"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="RECEIVED ALERTS"
            android:textColor="#79918E"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/alertsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No alerts received yet."
            android:textColor="#E8F0EC"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Demo: install on 3 Android phones. Start relay on all phones, then tap Send on Phone A. Keep internet and mobile data off, but leave Bluetooth/Wi-Fi enabled for Nearby Connections."
            android:textColor="#79918E"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
